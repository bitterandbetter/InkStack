# InkStack desktop AI local configuration.
# Do not commit real provider API keys.

# OpenAI / OpenAI-compatible endpoints.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5" # app model selector can override this

# Anthropic Claude.
ANTHROPIC_BASE_URL="https://api.anthropic.com"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-4-7" # app model selector can override this

# Google Gemini.
GEMINI_BASE_URL="https://generativelanguage.googleapis.com"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-pro-preview" # app model selector can override this

# DeepSeek.
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash" # app model selector can override this

# Kimi (Moonshot).
MOONSHOT_BASE_URL="https://api.moonshot.ai/v1"
MOONSHOT_API_KEY=""
MOONSHOT_MODEL="kimi-k3" # app model selector can override this

# Qwen (Alibaba Cloud Bailian / DashScope).
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_API_KEY=""
DASHSCOPE_MODEL="qwen3.8-max" # app model selector can override this

# Zhipu GLM.
ZHIPU_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_API_KEY=""
ZHIPU_MODEL="glm-5.2" # app model selector can override this

APP_URL="http://localhost:3000"
