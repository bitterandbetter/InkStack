{
  "name": "inkstack",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=1420 --host=127.0.0.1 --strictPort",
    "build": "vite build",
    "check": "npm run lint && npm test && npm run test:markdown && npm run test:markdown:visual && npm run test:wysiwyg:perf && npm run build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:markdown": "node --import tsx scripts/check_markdown_regression.ts",
    "test:markdown:visual": "tsx scripts/check_markdown_visual.ts",
    "test:wysiwyg:perf": "tsx scripts/benchmark_wysiwyg.ts",
    "themes:generate": "node scripts/typora_extract.mjs && node scripts/generate_typora_themes.mjs",
    "test:themes:visual": "tsx scripts/render_typora_theme_samples.ts",
    "test:tauri:visual": "bash scripts/capture_tauri_visual.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:fix-macos": "bash scripts/fix_macos_bundle.sh",
    "tauri:check-macos": "bash scripts/check_macos_release.sh",
    "tauri:build:mac": "npm run tauri:build",
    "tauri:build:mac:install": "npm run tauri:build:mac && bash scripts/move_installer.sh"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/api": "^2.10.1",
    "@uiw/react-codemirror": "^4.25.9",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "katex": "^0.16.45",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.8"
  }
}
